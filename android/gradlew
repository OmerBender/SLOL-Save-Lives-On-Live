#!/bin/bash
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
GRADLE_VERSION="8.6"
DIST_DIR="$GRADLE_USER_HOME/wrapper/dists/gradle-$GRADLE_VERSION-bin"

if [ ! -f "$DIST_DIR/gradle-$GRADLE_VERSION/bin/gradle" ]; then
    echo "Downloading Gradle $GRADLE_VERSION..."
    mkdir -p "$DIST_DIR"
    cd "$DIST_DIR"
    # Try to download
    if command -v curl &> /dev/null; then
        curl -o gradle-$GRADLE_VERSION-bin.zip "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
    elif command -v wget &> /dev/null; then
        wget "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
    else
        echo "ERROR: No curl or wget found"
        exit 1
    fi
    unzip -q gradle-$GRADLE_VERSION-bin.zip || true
fi

exec "$GRADLE_USER_HOME/wrapper/dists/gradle-$GRADLE_VERSION-bin/gradle-$GRADLE_VERSION/bin/gradle" "$@"
